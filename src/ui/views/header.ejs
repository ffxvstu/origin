<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    :root { color-scheme: light dark; }
    body {
      margin: 0;
      padding: 2rem 1.5rem;
      font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: #f6f7f9;
      color: #1f2328;
    }
    header { max-width: 960px; margin: 0 auto 1rem; }
    h1 { margin: 0 0 .25rem; font-size: 1.6rem; }
    .summary { margin: 0; color: #57606a; font-size: .9rem; }
    table {
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
      border-collapse: collapse;
      background: #fff;
      border: 1px solid #d0d7de;
      border-radius: 8px;
      overflow: hidden;
      font-size: .95rem;
    }
    thead th {
      text-align: left;
      padding: .7rem .9rem;
      background: #eef1f4;
      border-bottom: 1px solid #d0d7de;
      font-weight: 600;
    }
    tbody td { padding: .65rem .9rem; border-bottom: 1px solid #eaeef2; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: #f6f8fa; }
    .empty { text-align: center; color: #57606a; }
  </style>
</head>
<body>
  <header>
    <h1><%= title %></h1>
    <p class="summary">Total employees: <strong><%= total %></strong></p>
  </header>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Job</th>
      </tr>
    </thead>
